# Modelo de configuração. Nunca versione o .env nem compartilhe a senha em texto puro.
#   Docker:      copie para .env na raiz do projeto (ao lado do docker-compose.yml).
#   Sem Docker:  copie para backend/.env (lido pelo npm start).
# Não sobrescreva um .env existente: compare e acrescente só o que faltar.
SESSION_SECRET=d3e20b4e2a172cf5b23439bf1a44fd97ab6e3a798e58fe7acc01e1ddf055ced9
NODE_ENV=development
PORT=3000

# Usados só sem Docker (o docker-compose.yml define a conexão própria do container).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portal_certificacao
DB_USER=postgres
DB_PASSWORD=123

# Gere um segredo diferente de SESSION_SECRET (32 bytes aleatórios).
# No Docker, vazio usa o segredo de demonstração do docker-compose.yml.
RECUPERACAO_SECRET=

# --- Envio do código de recuperação de senha ---
# console: o código aparece no log da aplicação e nenhum e-mail é enviado.
#          Para quem não tem a credencial SMTP; só funciona com NODE_ENV=development.
# smtp (ou vazio): envio real; exige todas as variáveis SMTP_* abaixo preenchidas.
RECUPERACAO_MODO=console

# Gmail da equipe (preencha só no seu .env, nunca aqui):
# Servidor. Valor sugerido: smtp.gmail.com
SMTP_HOST=
# Porta. Valor sugerido: 465
SMTP_PORT=
# true para TLS direto (porta 465); false usa STARTTLS obrigatório (porta 587). Valor sugerido: true
SMTP_SECURE=
# Endereço do Gmail da equipe.
SMTP_USER=
# Senha de app do Google (16 letras), não a senha da conta. Antigo SMTP_PASSWORD.
SMTP_PASS=
# Remetente no formato "Nome <endereco>", com o mesmo endereço de SMTP_USER.
SMTP_FROM=

# Somente em development: true libera solicitações e reenvios para teste.
RECUPERACAO_SOLICITACOES_LIVRES=false
