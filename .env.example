# Copie para backend/.env sem sobrescrever valores existentes.
SESSION_SECRET=
NODE_ENV=development
PORT=

DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Gere um segredo diferente de SESSION_SECRET (32 bytes aleatórios).
RECUPERACAO_SECRET=
# smtp para envio real; console somente com NODE_ENV=development.
RECUPERACAO_MODO=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Somente em development: true libera solicitações e reenvios para teste.
RECUPERACAO_SOLICITACOES_LIVRES=false
